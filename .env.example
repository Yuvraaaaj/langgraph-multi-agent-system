# =============================================================================
# LangGraph Multi-Agent System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is listed in .gitignore.
# =============================================================================

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=30

# ── LLM / Model ──────────────────────────────────────────────────────────────
# Path to your local GGUF model (used by llama.cpp server)
MODEL_PATH=/path/to/your/model.gguf
GPU_LAYERS=-1
MODEL_CONTEXT_SIZE=2048
MODEL_TEMPERATURE=0.7

# ── Perplexica (AI Search) ────────────────────────────────────────────────────
# The base URL of your running Perplexica instance
PERPLEXICA_URL=http://localhost:3000

# ── SearXNG ──────────────────────────────────────────────────────────────────
SEARXNG_URL=http://localhost:8888

# ── Memory — Mem0 ────────────────────────────────────────────────────────────
# Optional: only needed if using Mem0 cloud tier
MEM0_API_KEY=

# ── Memory — Neo4j ───────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── Memory — Qdrant ──────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── System ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
WORKSPACE_DIR=./workspace
MAX_TASK_QUEUE_SIZE=100
MAX_ERROR_COUNT=5
