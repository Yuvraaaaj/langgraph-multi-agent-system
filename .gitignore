# =============================================================================
# LangGraph Multi-Agent System - .gitignore
# =============================================================================

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.env/
virtualenv/

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml
test-results/

# ── Type Checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ── IDEs & Editors ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.spyderproject.cfg
.ropeproject

# ── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Runtime / Data ───────────────────────────────────────────────────────────
workspace/
*.db
*.sqlite
*.sqlite3

# ── Model Files (too large for git) ──────────────────────────────────────────
*.gguf
*.bin
*.safetensors
models/

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints
*.ipynb

# ── Node (Perplexica) ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
